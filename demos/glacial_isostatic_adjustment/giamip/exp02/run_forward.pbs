#!/bin/bash
# GIAMIP Exp02: the forward run from the bed of an inversion
# (forward_exp02.py), on Gadi (NCI), queue normalsr (104 cores and 500 GB
# per node), with checkpoints and a restart after the wall time. This is the
# PBS version of run_forward_protocol.slurm and run_forward_fine.slurm.
#
# SCHEDULE selects the march (forward_exp02.py, THE TWO SCHEDULES and THE
# FINE SCHEDULES):
#   protocol (default)  every model year of the GIAMIP protocol: 500 yr
#                       steps to year -26000, then 100 yr steps to +1000
#                       (462 steps from 122 ka, 378 from 80 ka). The
#                       inversions of the Maxwell experiments on r2 march
#                       these years to year 0.
#   windows             schedule C, the protocol steps plus 25 yr and 10 yr
#                       steps in the fast melt windows (Exp09, Exp10,
#                       Exp12). With a schedule-C state file the ice to year
#                       0 comes from the file, as in the inversion.
# The surface fields and the scalars are written at the protocol years in
# both cases, so paraview_exp02.py reads the same series.
#
# The job must have the nodes and ranks of the prepare job that wrote the
# input file of the inversion; the script stops with an error otherwise.
# Nothing is taped, so the job uses no $PBS_JOBFS for a tape.
#
# Submit from the run directory of the forward run. For the r2 production
# that directory is on gdata, so that the outputs need no copy:
#
#   F=/g/data/xd2/sg8812/gia-mip/exp02/r2/forward-protocol
#   mkdir -p $F && cd $F
#   qsub -l ncpus=624,mem=3000GB,jobfs=2400GB,walltime=48:00:00 \
#       -v STATE=/scratch/xd2/$USER/giamip/exp02/8re_r2-6nodes/invert/state.h5 \
#       $MY_GADOPT/demos/glacial_isostatic_adjustment/giamip/exp02/run_forward.pbs
#
# Exp09, Exp10 and Exp12 add SCHEDULE=windows and use the directory
# forward-windows; ../submit_r2.sh sets both for each experiment.
#
# THE RESTART. The run copies STATE into the run directory
# (forward_state.h5), loads its meshes and fields from that copy and writes
# its checkpoints into it. The copy has the size of the state file (the
# input file with the ice of every step of the march plus the beds of the
# ROL iterations). With WALL_LIMIT_HOURS (default: the wall time of the job
# minus 1 h) the run writes a last checkpoint before that time, stops and
# leaves the file RESTART_NEEDED. This job then exits with code 3, so that
# jobs that wait for it with afterok (ParaView, images, archive) never run
# on a part of the march. Submit the next leg in the same directory with
# RESTART=1 and the same node count; it continues from the last checkpoint
# and appends to the surface file and the parameter log. The job does not
# submit the next leg itself: the watcher of the production does that
# (decision R9), together with new ParaView, image and archive jobs
# (submit_r2.sh ... forward with FORWARD_RESTART=1).
#
# Exit codes: 0 the march is finished (summary_forward.json says
# "finished"); 3 the run stopped at the wall limit with a checkpoint
# (RESTART_NEEDED); 4 the script exited with 0 without a finished summary;
# any other code is the code of mpiexec.
#
# THE SURFACE FILE. On Setonix the surface file went on one stripe of the
# flash pool, because the default layout of /scratch put some files on slow
# disk OSTs (run_forward_protocol.slurm, NOTES of 2026-10-20). Gadi /g/data
# has one stripe by default and no OST pools, so this script keeps the
# default layout and only prints it.
#
# Variables (pass them with -v NAME=value,...):
#   STATE             the state.h5 of the inversion (required on the first
#                     leg; a restart reads forward_state.h5)
#   SCHEDULE          protocol (default) or windows (see above)
#   REBUILD_EVERY     solves between preconditioner rebuilds (default 100,
#                     the setting of the r2 inversions; the rule also
#                     rebuilds at every change of dt)
#   WALL_LIMIT_HOURS  stop with a checkpoint before this wall time (default:
#                     the wall time of the job minus 1 h)
#   CHECKPOINT_EVERY  steps between periodic checkpoints (default 100: a
#                     checkpoint at the first protocol year at or after
#                     every 100 steps, and at year 0). A run that stops for
#                     another reason than the wall limit (a node fault)
#                     then continues with RESTART=1 from at most 100 steps
#                     back. Each checkpoint appends the displacement, the
#                     internal variables and the potential to
#                     forward_state.h5: an estimated 0.7 GB per set of
#                     internal variables on r2 (24 values per mantle cell,
#                     3.49 M cells; Exp09 and Exp12 carry one set per EB
#                     element) and about 0.2 GB for the rest.
#   RESTART           1 to continue from the last checkpoint
#   NP                the MPI ranks (default: all cores of the job)
#                     With fewer ranks than cores and NP a multiple of the
#                     nodes, the ranks are spread evenly over the cores of
#                     each node (a rank file, see the placement below).
#   EXTRA             further arguments of forward_exp02.py
#   ENV_FILE          the environment file (default ENV_DEFAULT below)
#   GDRIFT_DATA_DIR   the g-drift data cache (Exp08, Exp11, Exp12 only:
#                     forward_expXX.py imports prepare_expXX.py)
#   EXTRA_PYTHONPATH  a directory first on PYTHONPATH (default for Exp08,
#                     Exp11, Exp12: the giamip of python-extra-3d, as in
#                     run_prepare.pbs)
#
#PBS -N exp02-fwd
#PBS -P xd2
#PBS -q normalsr
#PBS -l ncpus=104
#PBS -l mem=500GB
#PBS -l jobfs=400GB
#PBS -l walltime=48:00:00
#PBS -l storage=scratch/xd2+gdata/xd2+gdata/fp50
#PBS -l wd
#PBS -W umask=0022
#PBS -j oe

set -u
# No core files from the processes of the first node (a stopped job of many
# ranks can fill the quota with them).
ulimit -c 0
PERSIST=/g/data/xd2/sg8812/giamip-software
# The environment of the inversion, so both jobs run the same code: the same
# default as in run_invert.pbs (ENV_DEFAULT there explains the files). The
# forward run also imports giamip (the ice of every protocol year), as the
# prepare job does in the same environment.
ENV_DEFAULT=${PERSIST}/env-giamip-pr4638-pr5544-pyop2fixes.sh
ENV_FILE=${ENV_FILE:-${ENV_DEFAULT}}
source ${ENV_FILE}
# The g-drift data cache (see run_prepare.pbs): the forward run imports the
# prepare script of its experiment for the ice transfer.
export GDRIFT_DATA_DIR=${GDRIFT_DATA_DIR:-${PERSIST}/gdrift-data}
# The forward run imports giamip and the prepare script of its experiment,
# so it needs the giamip of its prepare job.
# EXTRA_PYTHONPATH: a directory that goes first on PYTHONPATH. Exp08,
# Exp11 and Exp12 need the giamip of python-extra-3d (gia-mip 0cf5f39, as
# on Setonix), which carries the model files of their 3-D earth
# (prem-glad-m25.json, lloyd2024.json); the giamip 0.2.0 of python-extra
# in the environment file has not got them, and the prepare script stops
# with "names the fields None". The default below sets it for these three
# experiments only (the case word is the name of this directory, which the
# copy of this script changes): the other nine ran at L0 with the giamip of
# the environment, and their ice and topography must stay the same. An
# empty EXTRA_PYTHONPATH= on the qsub line turns it off.
case exp02 in
    exp08|exp11|exp12)
        EXTRA_PYTHONPATH=${EXTRA_PYTHONPATH-${PERSIST}/python-extra-3d} ;;
esac
if [ -n "${EXTRA_PYTHONPATH:-}" ]; then
    if [ ! -d "${EXTRA_PYTHONPATH}" ]; then
        echo "error: EXTRA_PYTHONPATH=${EXTRA_PYTHONPATH} is not a directory" >&2
        exit 1
    fi
    export PYTHONPATH=${EXTRA_PYTHONPATH}:${PYTHONPATH}
    echo "PYTHONPATH starts with ${EXTRA_PYTHONPATH}"
fi

HERE=${MY_GADOPT}/demos/glacial_isostatic_adjustment/giamip/exp02
OUT=${OUT:-${PBS_O_WORKDIR}}
SCHEDULE=${SCHEDULE:-protocol}
REBUILD_EVERY=${REBUILD_EVERY:-100}
RESTART=${RESTART:-0}
case ${SCHEDULE} in
    protocol|windows) ;;
    *) echo "error: SCHEDULE=${SCHEDULE}; use protocol or windows" >&2; exit 1 ;;
esac

# The wall time of this job from the PBS server (Resource_List.walltime,
# HH:MM:SS). The default wall limit of the run is this time minus 1 h: the
# run needs that margin for its last checkpoint (the save of the
# checkpoint and three of the slowest recent steps, forward_exp02.py).
if [ -z "${WALL_LIMIT_HOURS:-}" ]; then
    LIMIT=$(qstat -f ${PBS_JOBID} 2>/dev/null | awk '/Resource_List.walltime/ {print $3}')
    if [ -z "${LIMIT}" ]; then
        # Without the wall time a default could be longer than the job, and
        # PBS would stop the run without a checkpoint.
        echo "error: qstat gave no wall time for ${PBS_JOBID}; set WALL_LIMIT_HOURS" >&2
        exit 1
    fi
    WALL_LIMIT_HOURS=$(echo "${LIMIT}" | awk -F: '{printf "%.2f", $1 + $2 / 60 + $3 / 3600 - 1}')
    echo "job wall time ${LIMIT}, wall limit of the run ${WALL_LIMIT_HOURS} h"
fi
# A wall limit of 0 or less would stop the run after its first step.
if [ "$(awk -v w=${WALL_LIMIT_HOURS} 'BEGIN {print (w > 0) ? 1 : 0}')" != "1" ]; then
    echo "error: the wall limit ${WALL_LIMIT_HOURS} h is not positive" >&2
    exit 1
fi

ARGS="--output_path ${OUT} --schedule ${SCHEDULE}"
ARGS="${ARGS} --gia_rebuild_every ${REBUILD_EVERY}"
ARGS="${ARGS} --wall_limit_hours ${WALL_LIMIT_HOURS}"
ARGS="${ARGS} --checkpoint_every ${CHECKPOINT_EVERY:-100}"
mkdir -p ${OUT}
if [ "${RESTART}" = "1" ]; then
    # The state argument is required by the script; a restart reads the
    # run's own copy (forward_state.h5) and ignores it for the meshes.
    if [ ! -e "${OUT}/forward_state.h5" ]; then
        echo "error: RESTART=1, but ${OUT}/forward_state.h5 does not exist" >&2
        exit 1
    fi
    ARGS="${ARGS} --state ${STATE:-${OUT}/forward_state.h5} --restart"
else
    STATE=${STATE:?set STATE to the state.h5 of the inversion}
    # A new run in a directory of an earlier run would append to nothing
    # and overwrite its surface file; stop instead.
    if [ -e "${OUT}/forward_exp02_surface.h5" ]; then
        echo "error: ${OUT} holds the surface file of an earlier run; use RESTART=1 or a new directory" >&2
        exit 1
    fi
    rm -f ${OUT}/RESTART_NEEDED
    ARGS="${ARGS} --state ${STATE}"
fi
ARGS="${ARGS} ${EXTRA:-}"

NP=${NP:-${PBS_NCPUS}}
NODES=$(( PBS_NCPUS / 104 ))
# The placement of the ranks. With one rank per core (NP = PBS_NCPUS, the
# default) Open MPI maps and binds by core, as the Gadi configuration file
# of Open MPI (openmpi-mca-params.conf) sets. With fewer ranks than cores,
# every node gets the same number K of ranks, and a rank file binds local
# rank i of a node to the logical core floor(104 i / K) of the node: one
# rank per core, spaced evenly over the two sockets and the NUMA domains.
# An example is the 624-rank partition of a 6-node prepare job run on 16
# nodes with 39 ranks per node, which gives each rank more node disk
# ($PBS_JOBFS) for the tape. "--map-by ppr:K:node" alone binds the ranks
# to the logical cores 0 to K-1, which for K <= 52 are all on socket 0
# (--report-bindings on a Gadi login node), so half of the memory
# bandwidth of the node stays unused. hwloc numbers the logical cores
# socket by socket, so an even spacing of the logical numbers is an even
# spacing over the sockets. Open MPI refuses a rank file while the
# configuration file sets a mapping policy ("Conflicting directives for
# mapping policy"), so the job clears that policy. If NP does not divide
# by the nodes, the job uses --map-by ppr with the rounded-up count.
MAP=""
RANKFILE=""
if [ "${NP}" -lt "${PBS_NCPUS}" ]; then
    if [ $(( NP % NODES )) -eq 0 ]; then
        RPN=$(( NP / NODES ))
        RANKFILE=${OUT}/rankfile_${PBS_JOBID}.txt
        # One block of RPN lines per node, in the order of $PBS_NODEFILE,
        # so the ranks of a node are consecutive. Open MPI names the nodes
        # by the short host name.
        awk -v rpn=${RPN} '!seen[$1]++ {
                host = $1; sub(/\..*/, "", host)
                for (i = 0; i < rpn; i++)
                    printf "rank %d=%s slot=%d\n", n * rpn + i, host, int(i * 104 / rpn)
                n++ }' ${PBS_NODEFILE} > ${RANKFILE}
        export OMPI_MCA_rmaps_base_mapping_policy=
        MAP="--rankfile ${RANKFILE}"
    else
        MAP="--map-by ppr:$(( (NP + NODES - 1) / NODES )):node"
    fi
fi
echo "job ${PBS_JOBID} on ${NODES} nodes, ${NP} ranks"
echo "worktree ${MY_GADOPT} at $(cd ${MY_GADOPT} && git rev-parse --short HEAD 2>/dev/null)"
echo "firedrake overlay ${FIREDRAKE_PR4638_OVERLAY}: $(head -1 ${FIREDRAKE_PR4638_OVERLAY}/../BRANCH_COMMIT)"
echo "environment ${ENV_FILE}"
echo "pyop2 copy ${PYOP2_FIXES_OVERLAY:-${PYOP2_MIXED_DATASET_FIX}}"
echo "Lustre layout of new files in ${OUT}: $(lfs getstripe -d -c ${OUT} 2>/dev/null) stripe(s)"
echo "arguments: ${ARGS}"
date

# The check of the rank file: every rank starts /bin/true with the same
# placement and reports its binding (--report-bindings, all lines in
# rankfile_<job id>_bindings.txt). The job prints the binding of the first
# rank of each node, and per node the ranks on each socket and the number
# of distinct cores. It stops if Open MPI refuses the rank file.
if [ -n "${RANKFILE}" ]; then
    BINDINGS=${RANKFILE%.txt}_bindings.txt
    echo "rank placement: ${RPN} ranks per node from ${RANKFILE}"
    lscpu | grep -E '^(Socket|NUMA node)' | sed 's/^/  /'
    mpiexec -np ${NP} ${MAP} --report-bindings /bin/true > ${BINDINGS} 2>&1
    bind_status=$?
    # A line of --report-bindings: "[host:pid] MCW rank R bound to socket
    # S[core C[hwt 0]]: [B/./...][./...]".
    awk -v rpn=${RPN} '/ MCW rank / {
            h = $1; sub(/^\[/, "", h); sub(/[.:].*/, "", h)
            s = $8; sub(/\[.*/, "", s); c = $9; sub(/\[.*/, "", c)
            if ($4 % rpn == 0) { line = $0; sub(/: \[.*/, "", line); print "  " line }
            n[h]++; per[h, s]++; sockets[s] = 1
            if (!((h, c) in core)) { core[h, c] = 1; nc[h]++ } }
        END { for (h in n) { msg = "  " h ": " n[h] " ranks"
                  for (s in sockets) msg = msg ", socket " s " " per[h, s] + 0
                  print msg ", " nc[h] " distinct cores" } }' ${BINDINGS}
    if [ ${bind_status} -ne 0 ]; then
        echo "error: mpiexec with ${RANKFILE} failed (exit ${bind_status}), see ${BINDINGS}" >&2
        exit 1
    fi
fi

mpiexec -np ${NP} ${MAP} python3 ${HERE}/forward_exp02.py ${ARGS}
status=$?
date
echo "exit code of mpiexec ${status}"

# The gate for the jobs after this one (afterok): exit 0 only for a
# finished march. The summary of a finished run says "state": "finished";
# a stop at the wall limit writes "checkpointed" and RESTART_NEEDED.
if [ ${status} -eq 0 ]; then
    if [ -e ${OUT}/RESTART_NEEDED ]; then
        echo "RESTART_NEEDED: $(cat ${OUT}/RESTART_NEEDED); submit the next leg with RESTART=1 in ${OUT}"
        exit 3
    fi
    if ! grep -q '"state": "finished"' ${OUT}/summary_forward.json 2>/dev/null; then
        echo "error: the run exited with 0, but ${OUT}/summary_forward.json does not say finished" >&2
        exit 4
    fi
    echo "the march is finished"
fi
exit ${status}
