#!/bin/bash
#PBS -P vo05
#PBS -q normalsr
#PBS -l ncpus=104
#PBS -l mem=480GB
#PBS -l jobfs=100GB
#PBS -l walltime=48:00:00
#PBS -l storage=scratch/xd2+gdata/fp50+gdata/vo05
#PBS -l wd
# The Martinec et al. (2018) sea-level benchmark on the NCI Gadi cluster.
#
# Submit from this directory. Edit the storage list and the module lines for
# another cluster.
#
# The project and the storage are two independent things, and this script
# splits them. `-P` names the allocation that pays the service units, and the
# storage list names the filesystems the job can read and write. The default
# project is vo05 and the data stays on the scratch filesystem of xd2 (Sia,
# 2026-09-19: xd2 has 3.68 KSU left in 2026.q3 against 789 KSU in vo05, and
# the whole worktree with every earlier output sits under /scratch/xd2). The
# storage list also holds gdata/vo05, so that a run can read or write the data
# of the paying project without a change of this file, and gdata/fp50, which
# holds the Firedrake module.
#
# The `-P` directive is a default and `qsub` overrides it at submission:
#
#   qsub -P xd2 -v CASE=B run_martinec.pbs         # charge xd2 instead
#
# CAUTION: check the units of the project that pays before a long run, with
# `nci_account -P vo05`. A job that stops at the walltime keeps its checkpoint
# and `RESTART` continues it, but the units it used are spent.
#
#   qsub -v CASE=B run_martinec.pbs                      # case B to 10 kyr
#   qsub -v CASE=C run_martinec.pbs                      # case C to 15 kyr
#   qsub -v CASE=D run_martinec.pbs                      # case D to 15 kyr
#   qsub -v CASE=B,STEPS=2,LABEL=B-smoke -l walltime=02:00:00 run_martinec.pbs
#   qsub -v CASE=B,RESTART=3,RESTART_FILE=martinec-B.h5,LABEL=B-cont \
#        run_martinec.pbs
#
# Variables, with their defaults:
#
#   CASE=B            the benchmark case, B, C or D
#   NNODES=1          how many nodes the job asks mpiexec to fill. The
#                     resource lines above ask for one normalsr node, and PBS
#                     reads them before this script runs. NNODES=2 therefore
#                     needs the resources at submission as well, for example
#                     qsub -l ncpus=208 -l mem=960GB -v NNODES=2 ...
#                     The script stops if NNODES * NRANK is above the cpus of
#                     the allocation.
#   NRANK=96          ranks per node; the total is NNODES * NRANK
#   MESH=../3d_spada_selfgrav/b2_coarse_ar7.msh
#                     the mesh file. The coarse mesh is the smoke and G2 mesh;
#                     the 78 km refined mesh of this directory is the mesh of
#                     G2r, G3 and G4. Copy both files from the laptop and
#                     check the MD5. Do not regenerate them here: another gmsh
#                     version gives other tetrahedra, and a flat cell folds
#                     when the mesh is curved.
#                       b2_coarse_ar7.msh   f5072078dbf75567d9352b9cf64eec33
#                       martinec_h78_...msh 6bd1f84eb53de7ec3e84a0b038ac489a
#   GIA_MIP=$W/../gia-mip
#                     the gia-mip checkout, for the case and load files. The
#                     driver reads JSON only, so the checkout needs no install.
#   REPRESENTATION=lowrank    the DtN representation
#   MULTIPLIER_PC=gadopt.DtNMultiplierDenseSchurPC
#                     the block-1 preconditioner; pass none for the comparison
#   LABEL=$CASE       the label of every output file
#   OUTPUT=$PBS_O_WORKDIR
#   STEPS=            stop after this many steps, for a smoke run
#   RESTART=          continue from this state index of RESTART_FILE
#   RESTART_FILE=     the checkpoint to restart from. It is required with
#                     RESTART. The driver refuses to write over the file it
#                     reads, so give the continued run its own LABEL as well.
#   EXTRA=            any other driver options
#
# Cost, measured. Case B on the coarse mesh at 96 ranks costs 599.5 s per 100 yr
# step, 405.9 s per 50 yr step, 214.8 s per 10 yr step and 476.5 s for the
# elastic solve, at 73.57 GB of memory (job G2, 179385224). Case B marches 118
# steps of that ladder to 10 kyr, which is 17.74 h; case C and D march 300 steps
# of 50 yr. The refined mesh has 1.72 times the unknowns and 1.80 times the
# displacement and potential dofs, so it costs 30.5 to 31.9 h at 96 ranks, and it
# needs two nodes to keep the dofs per rank (see the G2r paragraph). At 192 ranks
# on two nodes it measures 153.12 GB (job G2r-smoke, 179428772). The Spada
# baseline of 127 s per 100 yr step at 78 GB (job 179238658) is 4.7 times
# cheaper per step than case B on the same mesh: sea level adds the ocean column
# of the load to block 0 and the dense Schur complement on block 1, so do not
# scale a sea-level cost from that baseline.
#
# Job G2-smoke: four arms of case B on the coarse mesh, two steps each. The
# four arms give two comparisons. The two representations must give the same
# solution, and the two block-1 preconditioners must give the same solution at
# a different cost. Each arm has its own label, so the four runs write
# different files into this directory. Submit the four lines from here. The
# walltime of each line is an estimate from job 179271032 (the frame on the
# low-rank path at `MULTIPLIER_PC=none`, 549 s for the elastic solve and 388 s
# and 424 s for the first two steps of 10 yr).
#
#   qsub -N g2s-lr-dense -j oe -o martinec-g2s-lowrank-dense.out \
#        -l walltime=02:00:00 \
#        -v CASE=B,STEPS=2,LABEL=g2s-lowrank-dense,REPRESENTATION=lowrank,MULTIPLIER_PC=gadopt.DtNMultiplierDenseSchurPC \
#        run_martinec.pbs
#   qsub -N g2s-lr-none -j oe -o martinec-g2s-lowrank-none.out \
#        -l walltime=03:00:00 \
#        -v CASE=B,STEPS=2,LABEL=g2s-lowrank-none,REPRESENTATION=lowrank,MULTIPLIER_PC=none \
#        run_martinec.pbs
#   qsub -N g2s-mult-dense -j oe -o martinec-g2s-multiplier-dense.out \
#        -l walltime=03:00:00 \
#        -v CASE=B,STEPS=2,LABEL=g2s-multiplier-dense,REPRESENTATION=multiplier,MULTIPLIER_PC=gadopt.DtNMultiplierDenseSchurPC \
#        run_martinec.pbs
#   qsub -N g2s-mult-none -j oe -o martinec-g2s-multiplier-none.out \
#        -l walltime=06:00:00 \
#        -v CASE=B,STEPS=2,LABEL=g2s-multiplier-none,REPRESENTATION=multiplier,MULTIPLIER_PC=none \
#        run_martinec.pbs
#
# The last arm is the most expensive one. Block 1 holds 77 rows on the
# multiplier representation at L = 5, and with `MULTIPLIER_PC=none` each
# block-1 GMRES iteration costs one block-0 solve. If that arm stops at the
# walltime, read the counts of the steps it finished: the comparison is a
# ratio of block-0 applications per solve, not a total.
#
# Job G2: case B on the production coarse mesh, to 10 kyr, on one node. The
# references are the VEGA profiles and the matched radopt run. The setting is
# the one G2-smoke measured as the cheapest of the four arms, the low-rank
# representation with the dense Schur complement on block 1, and both are the
# defaults of this script, so the line names only the case and the label.
#
#   qsub -N g2 -j oe -o martinec-g2.out -l walltime=24:00:00 \
#        -v CASE=B,LABEL=g2 run_martinec.pbs
#
# Job G2-K: the same run to 1 kyr with the bulk modulus at 1000 times the shear
# modulus, against G2 at 1 kyr. `STEPS=28` stops the march at 1 kyr: the ladder
# reaches 1 kyr in 10 steps of 10 yr and 18 steps of 50 yr, and the elastic
# solve at t = 0 is not one of the counted steps. The driver then writes the
# profiles of the last row it has, which is the row at 1 kyr. Write the ratio
# flag in the `=` form, because a `-v` list is separated by commas and a value
# with a space in it does not survive it: `--bulk-shear-ratio=1000` is one
# token and `--epochs 0 1` cannot go there at all.
#
#   qsub -N g2k -j oe -o martinec-g2k.out -l walltime=18:00:00 \
#        -v CASE=B,STEPS=28,LABEL=g2k,EXTRA=--bulk-shear-ratio=1000 \
#        run_martinec.pbs
#
# The walltime of the G2 line comes from arm 1 of G2-smoke (job 179341215, the
# same mesh and the same 96 ranks on one node): 476 s for the elastic solve,
# 260 s and 220 s for the first two steps of 10 yr, and 72.56 GB of memory.
# The Spada baseline is the only measured cost of a larger step on this mesh
# family, 64 s at 10 yr against 78 s at 50 yr and 127 s at 100 yr, which are
# factors of 1.22 and 1.98 on the 10 yr step. The ladder of case B to 10 kyr
# is 10 steps of 10 yr, 18 of 50 yr and 90 of 100 yr, that is 118 steps:
#
#   G2:    476 + 10 x 220 + 18 x 268 + 90 x 436 = 46 711 s = 13.0 h, 118 steps
#
# The walltime of the G2-K line is measured and not scaled from G2-smoke. Job
# 179385225 ran the line above at 08:00:00 and had to be stopped, because at a
# bulk modulus of 1000 times the shear modulus a step costs about 3.5 times a
# step of G2 and the run cannot reach 1 kyr in 8 hours. Over the same first
# four solves the two jobs measured:
#
#   quantity                              G2       G2-K    ratio
#   wall of the four solves          1 123 s    3 945 s     3.51
#   block-0 applications                  61        118     1.93
#   block-0 inner iterations           4 382     21 899     5.00
#   applications at the cap of 200  4 (6.6%)   99 (84%)
#
# Read the counts of that table at the right step. The `block0=` field of a
# TIMESTEP line is cumulative over the whole run, so the count of the first
# four solves is the field of step 3 and not of step 4, and the four solves are
# the elastic step 0 and the steps 1, 2 and 3. The count of the 29 solves to
# 1 kyr is the field of step 28, which is the step the 1 kyr epoch falls on.
# Counting the lines `Linear SelfGravitatingGIA_dtn_fieldsplit_0_condensed_
# solve ... iterations <n>` of the log gives the same numbers, one line per
# application and `n` inner iterations. Count the lines that did not converge
# as well: an application that reaches the cap prints `did not converge due to
# DIVERGED_ITS`, and a count of the converged lines alone misses every
# application at the cap.
#
# The reason is block 0. At 1000 times the shear modulus nearly every block-0
# application runs the full 200 iterations and exits DIVERGED_ITS, so it never
# reaches its relative tolerance of 1e-4. The outer solve still converges in 5
# or 6 iterations, because FGMRES accepts a preconditioner that changes between
# iterations, so the answer is right to the outer tolerance of 1e-6 and only
# the cost changes. Do not raise the cap for this line: a larger cap makes the
# applications that reach it more expensive and buys nothing that the outer
# tolerance does not already give.
#
#   G2-K:  1 111 + 10 x 945 + 18 x 1 682         = 40 835 s = 11.3 h,  28 steps
#
# The factor 1.78 from a 10 yr step to a 50 yr step is the one G2 measured on
# this mesh and this case, a mean of 382 s over 5 steps against 215 s over 10,
# and not the 1.22 of the Spada load.
#
#   job     steps  estimate  request   margin  measured wall  measured SU
#   G2      118    13.0 h    24:00:00  1.85    17 h 48 min    3 701.94
#   G2-K     28    11.3 h    18:00:00  1.58    12 h 53 min    2 679.33
#   G2r     118    20.0 h    48:00:00  2.40    -              -
#
# The two measured columns are the outcome of the two jobs, 179385224 and
# 179389239. The estimate of the G2 line is 1.37 times too small, and the whole
# of that factor is in the larger steps: the line took the factors 1.22 and 1.98
# of the Spada load, and case B on this mesh measures 1.89 and 2.79 (the table
# of the G2r paragraph below). The measured G2-K estimate is right to 1.14. So a
# step ratio of this benchmark has to be measured on this benchmark, and the
# G2r estimate below uses the measured steps of G2 and no model of them.
#
# normalsr charges 2 SU per cpu-hour and PBS charges the 104 cpus of the
# allocation, so one node costs 208 SU per hour of wall (measured: arm 1 used
# 19 minutes and 65.87 SU). Gadi reserves the units of the request while the
# job waits and runs, and it returns the part the job does not use, so the two
# requests hold 4 992 SU and 3 744 SU. vo05 holds 789 KSU in 2026.q3, so the
# units do not limit the request.
#
# Two reasons for the margin of the G2 line. The cost per step is not constant:
# the mean inner iterations per block-0 application rise 57, 62 and 118 over
# the three solves of G2-smoke, so a linear scale of the cheapest measured step
# is a lower bound. And the factors 1.22 and 1.98 come from the Spada load and
# not from case B.
#
# Memory: one node gives 480 GB against the 72.56 GB of arm 1, a factor of 6.6,
# so neither line needs a memory option.
#
# Job G2r: case B on the 78 km refined mesh, to 10 kyr, on two nodes. The
# references are job G2 on the coarse mesh and the VEGA profiles. Two lines, in
# this order. The first line measures the cost and the memory of two steps. The
# second line marches the 118 steps of the ladder, and it carries a dependency
# on the first, so that it starts only after a clean smoke run.
#
#   qsub -N g2r-smoke -j oe -o martinec-g2r-smoke.out \
#        -l ncpus=208 -l mem=960GB -l walltime=03:00:00 \
#        -v NNODES=2,CASE=B,STEPS=2,LABEL=g2r-smoke,MESH=martinec_h78_cap12_band4_gl0.5_depth500_base500_grade2_ll1_mc32_alg1_seed7.msh \
#        run_martinec.pbs
#   qsub -N g2r -j oe -o martinec-g2r.out \
#        -l ncpus=208 -l mem=960GB -l walltime=48:00:00 \
#        -W depend=afterok:<the job id of the smoke line> \
#        -v NNODES=2,CASE=B,LABEL=g2r,MESH=martinec_h78_cap12_band4_gl0.5_depth500_base500_grade2_ll1_mc32_alg1_seed7.msh \
#        run_martinec.pbs
#
# Submitted on 2026-09-20 as 179428772 (the smoke line) and 179428774 (the
# march, held on `afterok:179428772`), both charged to vo05 from the Gadi
# worktree at `c6a3a44a`. The smoke line finished with exit 0 in 17 min 25 s and
# 120.76 SU, at 153.12 GB of memory, and the march left its hold by itself.
#
# What the smoke line measured, beside the same three solves of G2 (the elastic
# step and two steps of 10 yr, at 96 ranks on the coarse mesh):
#
#   quantity                        G2r-smoke, 192 ranks   G2, 96 ranks
#   wall of the three solves                     837.4 s       917.7 s
#   wall of each solve             413.0, 212.2, 212.1 s   476.5, 261.4, 179.7 s
#   outer iterations per solve                     4, 4, 3       6, 5, 3
#   block-0 applications                              43            52
#   block-0 inner iterations                       3 065         3 410
#   applications at the cap of 200            2 (4.7 pc)    2 (3.8 pc)
#   wall per inner iteration                    0.2732 s      0.2691 s
#   dense-complement asymmetry, elastic build     1.553e-05     8.697e-06
#   dense-complement asymmetry, step 1 build      6.010e-06     2.220e-05
#   memory                                     153.12 GB      73.57 GB
#   mesh read / solver build                 11.9 s / 89.0 s          -
#
# Three readings of that table. The cost per block-0 inner iteration is the same
# on both, 0.2732 s against 0.2691 s, so the refined mesh at twice the ranks
# costs 1.5 percent more per iteration for 1.72 times the unknowns: a parallel
# efficiency of 0.85 over the doubling, above the 0.8 the estimate assumed.
# Block 0 is not worse on the refined mesh over these three solves: it needs 43
# applications against 52 and 3 065 inner iterations against 3 410, and the
# asymmetry of the dense complement is inside a factor of 4 of the G2 value at
# the same build (the table compares build against build, because the value
# changes by two orders of magnitude between the builds of one run). And the
# memory is 2.08 times the memory of G2, above the dof ratio of 1.72, because
# the fixed cost per rank is paid by 192 ranks and not by 96; 153.12 GB is 6.3
# times inside the request of 960GB.
#
# The smoke line comes first, because every resource of the march is a scale of
# a coarse-mesh measurement. Two steps cost about 20 minutes of wall, and they
# give the memory, the step wall at 192 ranks and the fraction of the block-0
# applications that reach the iteration cap. `-W depend=afterok` holds the march
# until the smoke line exits 0. A failure of the smoke line therefore stops the
# march before it spends any units, and PBS then deletes the held job.
#
# Resources: two nodes, 208 cpus, 192 ranks at NRANK=96. The reasons:
#
#   Cores. The refined mesh has 8 511 866 unknowns against 4 942 922 on the
#   coarse mesh, a ratio of 1.72 on the total and of 1.80 on the displacement
#   and potential dofs. At the dofs per rank of the Spada baseline the refined
#   mesh needs 165 to 173 ranks, which is more than the 104 cpus of one node.
#   Memory. G2 used 73.57 GB on the coarse mesh at 96 ranks. The dof ratio gives
#   127 to 133 GB, and the smoke line measured 153.12 GB, which is the number to
#   use: 192 ranks and not 96 pay the fixed cost per rank. That is 77 GB per node
#   of a two-node job against the 480 GB of one node, so the request of 960GB is
#   6.3 times the measured need. The 191 GB of the earlier estimate came from the
#   Spada baseline and is superseded.
#   Walltime. The measured wall of G2 is 17.74 h on one node, so one node on the
#   refined mesh is 30.5 to 31.9 h against the 48 h limit of normalsr, and the
#   block-0 growth below can pass that limit. Two nodes give 19.1 to 20.0 h.
#
# NRANK stays at 96, as in every measured job of this branch. PBS charges the
# 104 cpus of the allocation at any value of NRANK, and 96 ranks per node keep
# the step time comparable with G2 and with the Spada baseline.
#
# The walltime estimate comes from the measured steps of G2 and not from a model
# of them. G2 marched this ladder on the coarse mesh at 96 ranks and printed the
# wall of every step. The four segments of that run:
#
#   segment         steps   mean wall        sum   ratio to the 10 yr step
#   elastic solve       1    476.5 s      476.5 s   -
#   dt = 10 yr         10    214.8 s    2 147.8 s   1.00
#   dt = 50 yr         18    405.9 s    7 306.6 s   1.89
#   dt = 100 yr        90    599.5 s   53 950.5 s   2.79
#   all               119               63 881 s = 17.74 h
#
# The job wall of G2 is 17 h 47 min 52 s, so the setup outside the steps costs
# about 4 minutes. The refined mesh at 192 ranks scales that sum by the dof
# ratio and by the rank ratio:
#
#   63 881 s x 1.72 / (2 x 0.8) = 68 672 s = 19.1 h   at the dof ratio 1.72
#   63 881 s x 1.80 / (2 x 0.8) = 71 866 s = 20.0 h   at the dof ratio 1.80
#
# The 0.8 is an assumed parallel efficiency over the doubling of the ranks, and
# the smoke line measured 0.85. The same sum scaled by the measured ratios of
# the smoke line brackets the march:
#
#   63 881 s x 0.913 = 58 291 s = 16.2 h   at the wall ratio of the three solves
#   63 881 s x 1.18  = 75 385 s = 20.9 h   at the wall ratio of step 2 alone
#
# The two ratios differ because the refined mesh took fewer block-0 applications
# in the first two solves (17 and 17 against 23 and 20), and that advantage can
# stop at any step. Step 2 is the one solve of the pair that did identical work,
# 9 applications at 3 outer iterations in both runs, so 1.18 is the ratio to
# carry. The request of 48:00:00 is the limit of normalsr at 208 cpus, so the
# march holds a factor of 2.3 over 20.9 h.
#
# What can raise the estimate, and the bound on it. G2 ran 1 923 block-0
# applications with 301 627 inner iterations, a mean of 156.9 of a cap of 200,
# and 1 093 of the applications (57 percent) reached that cap. The refined mesh
# has a wider spread of the CG2 Laplacian diagonal, 13.5 times the median
# against 8.7 times, so more of its applications reach the cap. The cap bounds
# what that costs: an application never runs more than 200 inner iterations, so
# the inner work per application can rise by at most 200 / 156.9 = 1.27. Two
# bounds follow, and they use different factors. On the 20.0 h estimate of the
# dof ratio, both factors together, 1.27 for the inner work and 1.2 for a rise of
# the outer count, give 30.4 h. On the measured 20.9 h of the smoke line, the
# 1.27 alone gives 26.6 h and both factors give 31.9 h. Every one of the three is
# inside the request of 48 h. The smoke line then measured the start of the
# march: 2 of its 43 applications reach the cap, against 2 of 52 in G2 over the
# same three solves, so the wider spread of the Laplacian diagonal costs nothing
# there. If the march still stops at the walltime, the checkpoint of step 100
# continues it with RESTART and RESTART_FILE.
#
# The cost. normalsr charges 2 SU per cpu-hour and PBS charges the 208 cpus of
# the allocation, so the march costs 416 SU per hour of wall: about 8 300 SU at
# the estimate of 20.0 h, about 12 600 SU at the bound of 30.4 h and 19 968 SU
# if it runs to the request. The smoke line cost 120.76 SU, measured. Gadi
# reserves the units of the request while the job waits and runs, and it returns
# the part the job does not use. vo05 held 752.84 KSU on 2026-09-20.
# CAUTION: check the available service units of the paying project with
# `nci_account -P vo05` before you submit the march. A job that stops at the
# walltime keeps its checkpoint, and `RESTART` continues it, but the units it
# used are spent.
#
# Disk. G2 wrote a checkpoint file of 730 MB for its seven checkpoints and a log
# of 72 MB. The refined mesh gives about 1.3 GB and about 150 MB. The xd2
# scratch filesystem held 22.64 TiB of a quota of 22.97 TiB on 2026-09-20, so
# the output of the march fits, and that margin is for the whole project.
#
# Block 0. The march runs the settings of G2 and changes nothing: the relative
# tolerance of 1e-4 and the iteration cap of 200. This replaces the rule that
# stood here before, which raised the cap to 400 when more than a tenth of the
# applications of the smoke log exit `DIVERGED_ITS`. G2 measured why that rule
# is wrong. The cap binds in 1 093 of its 1 923 applications, which is 57
# percent and far above a tenth, and the outer FGMRES still converged on
# CONVERGED_RTOL at every one of the 119 solves, in 3 to 6 iterations with a
# mean of 4.44 and with a largest relative mass dipole of 4.2e-10 against the
# outer tolerance of 1e-6. The outer tolerance and not the cap controls the
# answer, because FGMRES accepts a preconditioner that changes between
# iterations. A larger cap makes every saturated application more expensive and
# buys nothing. The G2-K paragraph above reaches the same conclusion at 95
# percent saturation. The rule was also read over the wrong window: the first
# four solves of G2 give 4 of 61 applications at the cap, which is 6.6 percent,
# so a smoke log of two steps does not measure what the march does.
#
# Count the applications at the cap for the record, in the smoke log and in the
# march log. Include the lines that did not converge, because an application at
# the cap prints `did not converge due to DIVERGED_ITS`:
#
#   grep -c "condensed_ solve did not converge" martinec-g2r-smoke.out
#   grep -c "condensed_ solve converged" martinec-g2r-smoke.out
#
# Change block 0 for one reading of a log only: the run stops with a KSP
# convergence error, so the outer solve did not reach its relative tolerance of
# 1e-6 at some step. That reading is the only one that says the answer is wrong.
# The change is then `EXTRA=--block0-max-it=400`, and it is the safe direction: a
# larger cap costs wall clock in the applications that reach it and changes
# nothing in the applications that do not. Write the flag in the `=` form,
# because a `-v` list is separated by commas and a value with a space in it does
# not survive it. Record the setting beside the counts, because every other 3-D
# number of this branch is at a cap of 200.
#
# Two other quantities measure the cost of an inexact block 0 and not the
# accuracy of the answer. Report both for the march, with the G2 value beside
# each, and do not read a threshold from them:
#
#   the outer iteration count per solve. G2 gives 3 to 6 with a mean of 4.44
#   over its 119 solves, and 3 to 6 with a mean of 3.79 over its first 29
#   solves, which is the window to 1 kyr.
#   the relative asymmetry of the dense Schur complement of block 1, build by
#   build. G2 builds the complement four times and prints 8.697e-06 at the
#   elastic solve, 2.220e-05 at step 1, 1.577e-05 at step 11 (the change to
#   dt = 50 yr) and 7.274e-04 at step 29 (the change to dt = 100 yr). The range
#   over the whole march is therefore 8.7e-06 to 7.3e-04. The narrower range
#   8.7e-06 to 2.2e-05 holds for the two builds inside a two-step smoke window
#   only. The G2r march log holds the same four builds, so compare the value of
#   one build against the G2 value of the same build.
#
# Neither quantity carries a threshold, and the reason is G2-K. It is the one
# measured run that sits high in both, and the G2-K paragraph above says not to
# raise the cap there. G2-K prints 1.053e-03 at the elastic solve, 2.252e-03 at
# step 1 and 2.083e-03 at step 11, which is about 100 times the G2 value at the
# same build, and its outer count is 6 to 12 with a mean of 8.45 over 29 solves.
# Its outer solve still reached 1e-6 at every step. A threshold at 1e-3 on the
# asymmetry, or at a mean outer count of 8, therefore fires on that reference run
# and contradicts the instruction above it. The 1e-3 threshold also sits only 1.4
# times above the 7.274e-04 that G2 itself prints at step 29. To raise the cap on
# cost grounds, measure both caps over the same steps and compare the wall clock.
# Do not infer the cost from either signal.
source /etc/profile
module use /g/data/fp50/modules
module load firedrake/main-20260902
ulimit -s unlimited 2>/dev/null || true

# This directory and the repository root, which must come first on
# PYTHONPATH so that `import gadopt` loads this checkout.
D=$PBS_O_WORKDIR
W=$(cd "$D/../../.." && pwd)
export PYTHONPATH=$W:$D:$PYTHONPATH
export PYTHONDONTWRITEBYTECODE=1 OMP_NUM_THREADS=1 OMPI_MCA_io=ompio
# PETSc options can be added at submission, for example -log_view.
: ${PETSCOPTS:=}
export PETSC_OPTIONS="$PETSCOPTS"
cd "$D"

: ${CASE:=B}
: ${NNODES:=1}
: ${NRANK:=96}
: ${MESH:=../3d_spada_selfgrav/b2_coarse_ar7.msh}
: ${GIA_MIP:=$W/../gia-mip}
: ${REPRESENTATION:=lowrank}
: ${MULTIPLIER_PC:=gadopt.DtNMultiplierDenseSchurPC}
: ${LABEL:=$CASE}
: ${OUTPUT:=$D}
: ${STEPS:=}
: ${RESTART:=}
: ${RESTART_FILE:=}
: ${EXTRA:=}

# The optional flags, each empty unless its variable is set.
STEPS_FLAG=
[ -n "$STEPS" ] && STEPS_FLAG="--steps $STEPS"
RESTART_FLAG=
if [ -n "$RESTART" ]; then
    # The driver requires both, and it writes martinec-$LABEL.h5, so a
    # continued run needs a LABEL of its own. Fail here and not after the
    # meshes: a job that stops at once costs no walltime.
    if [ -z "$RESTART_FILE" ]; then
        echo "RESTART needs RESTART_FILE, the checkpoint of the earlier run" >&2
        exit 2
    fi
    RESTART_FLAG="--restart $RESTART --restart-file $RESTART_FILE"
fi

NTOTAL=$((NNODES * NRANK))

# The resource lines at the top of this file are read by PBS before any
# variable of this script exists, so NNODES cannot change them. Stop here if
# the job asks mpiexec for more ranks than the allocation holds: the failure
# is immediate either way, and this message says what to do.
if [ -n "$PBS_NCPUS" ] && [ "$NTOTAL" -gt "$PBS_NCPUS" ]; then
    echo "NNODES*NRANK=$NTOTAL is above the allocation PBS_NCPUS=$PBS_NCPUS." >&2
    echo "Submit with -l ncpus=$NTOTAL and the matching -l mem." >&2
    exit 2
fi

echo "=== gadopt: $(python3 -c 'import gadopt; print(gadopt.__file__)') ==="
echo "=== git:    $(git -C "$W" rev-parse --short HEAD) ==="
echo "=== mesh:   $MESH  md5 $(md5sum "$MESH" | cut -d' ' -f1) ==="
echo "=== CASE=$CASE LABEL=$LABEL REPRESENTATION=$REPRESENTATION ==="
# The block-1 preconditioner is the second variable of the smoke comparison,
# so the banner names it beside the representation. The driver prints it too.
echo "=== MULTIPLIER_PC=$MULTIPLIER_PC STEPS=${STEPS:-all} ==="
echo "=== NNODES=$NNODES NRANK=$NRANK NTOTAL=$NTOTAL ==="
echo "=== started $(date) on $(hostname) ==="

# shellcheck disable=SC2086
mpiexec -np $NTOTAL --map-by ppr:$NRANK:node python3 -u martinec_benchmark.py \
    --case $CASE --mesh $MESH --gia-mip $GIA_MIP \
    --dtn-representation $REPRESENTATION --multiplier-pc $MULTIPLIER_PC \
    --label $LABEL --output $OUTPUT \
    $STEPS_FLAG $RESTART_FLAG $EXTRA 2>&1
RC=$?

echo "=== finished $(date), exit $RC ==="
exit $RC
