#!/bin/bash
#PBS -P xd2
#PBS -q normalsr
#PBS -l ncpus=104
#PBS -l mem=480GB
#PBS -l jobfs=100GB
#PBS -l walltime=10:00:00
#PBS -l storage=scratch/xd2+gdata/fp50
#PBS -l wd
# The Spada et al. (2011) benchmark, both cases, on the NCI Gadi cluster.
#
# Submit from this directory. Edit the project (-P), the storage list and the
# module lines above and below for another allocation or another cluster.
#
#   qsub run_spada_benchmark.pbs                                  # cap case, 0 to 20 kyr
#   qsub -v CASE=polar-motion run_spada_benchmark.pbs             # polar-motion case
#   qsub -v EPOCHS="0 1",LABEL=cap-probe -l walltime=02:00:00 run_spada_benchmark.pbs
#
# Resources of the validated cap run to 20 kyr (96 ranks, CG3 displacement,
# DG2 internal variables): 5 h 56 min wall time and 106 GB peak memory. That
# run used an earlier solver configuration (internal variables eliminated
# pointwise, DtN multipliers). Restart steps with the current default solver
# were cheaper per step, but no full run with it exists, so the wall time
# request keeps a margin over the validated run.
#
# The time step grows along the ladder from 10 yr to 500 yr. The effective
# bulk/shear ratio of one step is K/mu * (1 + dt/tau), so the 500 yr segment
# is the most expensive per step. A probe that stops at 1 kyr underestimates
# the cost per step of the full run.
source /etc/profile
module use /g/data/fp50/modules
module load firedrake/main-20260902
ulimit -s unlimited 2>/dev/null || true

# This directory and the repository root, which must come first on
# PYTHONPATH so that `import gadopt` loads this checkout.
D=$PBS_O_WORKDIR
W=$(cd "$D/../../.." && pwd)
export PYTHONPATH=$W:$D:$PYTHONPATH
export PYTHONDONTWRITEBYTECODE=1 OMP_NUM_THREADS=1 OMPI_MCA_io=ompio
# PETSc options can be added at submission, for example -log_view.
: ${PETSCOPTS:=}
export PETSC_OPTIONS="$PETSCOPTS"
cd "$D"

: ${NRANK:=96}
: ${CASE:=cap}
: ${MESH:=b2_coarse_ar7.msh}
: ${EPOCHS:=0 0.1 1 2 5 10 20}
: ${LABEL:=$CASE}
: ${OUTPUT:=$D}
: ${EXTRA:=}

echo "=== gadopt: $(python3 -c 'import gadopt; print(gadopt.__file__)') ==="
echo "=== git:    $(git -C "$W" rev-parse --short HEAD) ==="
echo "=== CASE=$CASE LABEL=$LABEL MESH=$MESH EPOCHS=[$EPOCHS] NRANK=$NRANK ==="
echo "=== started $(date) on $(hostname) ==="

# shellcheck disable=SC2086
mpiexec -np $NRANK --map-by ppr:$NRANK:node python3 -u spada_benchmark.py \
    --case $CASE --mesh $MESH --epochs $EPOCHS --label $LABEL \
    --output $OUTPUT $EXTRA 2>&1
RC=$?

echo "=== finished $(date), exit $RC ==="
exit $RC
