# Working notes, plans, handovers and benchmark scratch. Local only - these are
# a private research record, not part of the repository.
NOTES/

# Generated meshes. Rebuilt by demos/gravity/generate_*.py; 47 MB of them in
# the gravity demos alone, and none has ever been tracked.
*.msh
# The one exception: the small mesh that the GIA unit tests read, so that their
# stored reference values do not depend on the gmsh of the machine.
!tests/unit/data/*.msh

*.pvd
*.vtu
*.pvtu
*.h5
# Small checkpoint files that the GIA unit tests read.
!tests/unit/data/*.h5
*.dat
*.conv
*.log
*.cereal
*.ipynb
__pycache__/
.doit.db.db

ARCHIVE-DO-NOT-READ.tar.gz

# Reference benchmark data, obtained from elsewhere - never tracked here.
WSCOTT-2023/
